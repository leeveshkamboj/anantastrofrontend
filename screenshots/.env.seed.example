# Screenshot seed fixtures — copy to .env.seed and fill in values
# cp screenshots/.env.seed.example screenshots/.env.seed

# App URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Primary user (reports, wallet, services, chat)
USER_EMAIL=screenshot-user@example.com
USER_PASSWORD=ScreenshotUser123!

# Admin
ADMIN_EMAIL=screenshot-admin@example.com
ADMIN_PASSWORD=ScreenshotAdmin123!

# Approved astrologer dashboard
ASTROLOGER_EMAIL=screenshot-astrologer@example.com
ASTROLOGER_PASSWORD=ScreenshotAstro123!

# Non-astrologer applicant (register wizard)
APPLICANT_EMAIL=screenshot-applicant@example.com
APPLICANT_PASSWORD=ScreenshotApplicant123!

# Low coin balance user
LOW_WALLET_EMAIL=screenshot-lowwallet@example.com
LOW_WALLET_PASSWORD=ScreenshotLow123!

# Empty reports / conversations user
NEW_USER_EMAIL=screenshot-newuser@example.com
NEW_USER_PASSWORD=ScreenshotNew123!

# Google OAuth user without password (optional)
GOOGLE_USER_EMAIL=
GOOGLE_USER_PASSWORD=

# Completed report IDs (UUIDs from seeded data)
KUNDLI_RESULT_ID=
KUNDLI_SHARE_TOKEN=
HOROSCOPE_RESULT_ID=
HOROSCOPE_SHARE_TOKEN=
HOROSCOPE_DETAILED_RESULT_ID=
MATCHMAKING_RESULT_ID=
MATCHMAKING_SHARE_TOKEN=

# Chat sessions (UUIDs)
CHAT_SESSION_ID=
LOW_BALANCE_CHAT_SESSION_ID=

# Admin detail page numeric IDs
ADMIN_USER_ID=
ADMIN_ASTROLOGER_ID=
ADMIN_REQUEST_ID=

# Phase 6 optional (consumes token on use)
FRESH_VERIFY_TOKEN=
MOCK_OAUTH_JWT=
