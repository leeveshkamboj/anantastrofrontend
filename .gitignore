# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.cursor
*-lock.json
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
!.env.seed.example
!.env.deploy.example

# screenshot tooling (generated assets + secrets)
/screenshots/**/*.png
/screenshots/.env.seed
/storage/

# stitch design mockups (keep markdown specs, ignore large PNGs)
/stitch/**/screen.png

# local agent planning drafts (PRDs, issue breakdowns — published to GitHub instead)
.scratch/

# design reference exports (mockups, html dumps — not app source)
/design_refrence/

# raw source photos before optimization into public/images/
/pics/

# playwright
/playwright-report/
/test-results/
/blob-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
